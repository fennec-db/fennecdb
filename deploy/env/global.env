# /etc/fennecdb/global.env -- the global router (fennec-global.service), and
# in another region its standby (fennec-global-standby.service): the same
# file but for FENNEC_LISTEN, and FENNEC_PRIMARY, which the standby alone
# reads. Mode 0600, owned by root (node.env says why). Every value is an
# example: make each token with `openssl rand -hex 32`. A router listening
# past loopback refuses a token shorter than 32 bytes at the start, each
# example here among them, so none is left in place by mistake.

# The private network's address: the regions' routers follow its directory
# and relay to it the changes every region must agree on.
FENNEC_LISTEN=10.1.0.31:8090
# The standby's: the global router it follows.
FENNEC_PRIMARY=http://10.1.0.31:8090

# How long it waits on a region's router for each read of an answer, as a
# region's router waits on a node (router.env's FENNEC_UPSTREAM_TIMEOUT):
# the same value.
FENNEC_UPSTREAM_TIMEOUT=10

# The same three as every region's router (router.env).
FENNEC_SHARD_TOKEN=change-me-routers-token
FENNEC_SHARD_REPLICATION_TOKEN=change-me-directories-token
FENNEC_SHARD_ENTRY_TOKEN=change-me-entry-token

# Anything more, split at spaces: the region a tenant made naming none is
# placed in, CORS, tracing.
FENNEC_GLOBAL_FLAGS=--default-region eu
