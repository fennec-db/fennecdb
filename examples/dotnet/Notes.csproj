<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="schema.fennecql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The published package; `-p:FennecLocal=<repository root>` builds against
       this repository's SDK instead, as CI does. -->
  <ItemGroup Condition="'$(FennecLocal)' == ''">
    <PackageReference Include="FennecDb" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(FennecLocal)' != ''">
    <ProjectReference Include="$(FennecLocal)/integrations/dotnet/FennecDb/FennecDb.csproj" />
  </ItemGroup>
</Project>
