-- The schema every `fennec types` generator is held to: each file beside this
-- one is what `fennec types` writes for it in one language or form, and the
-- CLI's tests make each again (FENNEC_TYPES_GOLDEN=write cargo test -p
-- fennec-cli types writes them). Every type, a required field and not, a
-- collation, a field compared by its case fold, every index and a path
-- index, indexes over several fields, a name past ASCII, and a collection
-- named as a builder is. Then named statements, each typed by its
-- arguments and its answer: every parameter type and defaults, none at
-- all, claims (never arguments), plain fields required and not, a write's
-- `returning`, a count, items not typed yet (computed, renamed, a path, a
-- `lookup`'s rows), a write answering only what it wrote, and parameters
-- named as keywords are.
create collection articles (
  title text required collate tr @text(prefix=6, chars),
  year int @hash,
  score float @sorted,
  draft bool required,
  published timestamp @ttl(30d),
  cover bytes,
  meta json,
  loc geo @geo,
  embed vector<384> @hnsw(cosine, m=8),
  small vector<4, f16> @hnsw(l2, quant=int8),
  splade sparse<30522> @inverted,
  tags [text] @hash,
  counts [int] required,
  slug text nocase @unique,
  @sorted(draft, published desc),
  @unique(year, meta.lang)
)
create index on articles (meta.lang) @hash
create index on articles (meta.source.rank) @sorted
create collection product_reviews (product_id int required @hash, stars int, notes text collate und)
create index on product_reviews (product_id, stars desc) @sorted
create collection kişiler (ad text, yaş int)
create collection text (body text)
create statement every_type($flag bool, $year int, $score float, $title text, $cover bytes,
    $at timestamp, $meta json, $loc geo, $embed vector<384>, $small vector<4, f16>,
    $splade sparse<30522>, $tags [text], $counts [int], $limit int = 10, $note text = null)
  comment 'Every parameter type, and two with a default.'
  as get articles select id, title, year, draft, published, cover, meta, loc, embed, small,
    splade, tags, counts, slug where year = $year limit $limit
create statement article_count() comment 'No parameters, and a count.' as get articles count
create statement my_reviews($product int) claims (sub text, groups [text] from "cognito:groups")
  as get product_reviews select id, product_id, stars, notes
    where product_id = $product and notes = $jwt.sub
create statement rate($review int, $stars int) public
  as set product_reviews {stars: $stars} where id = $review returning id, stars
create statement reviews_by_stars() as get product_reviews select stars, count(*) group stars
create statement headlines($year int)
  as get articles select title as headline, score * 2 as doubled, meta.lang where year = $year
    lookup product_reviews on product_id = id select stars
create statement forget_reviews($product int) public
  as del product_reviews where product_id = $product
create statement move_reviews($from int, $to int, $in bool = true, $class text = null) public
  comment 'Parameters named as Python, Swift, Kotlin and Dart keywords: */ and /* in a comment.'
  as set product_reviews {product_id: $to} where product_id = $from returning id, product_id
