{
  "name": "@fennecdb/web",
  "version": "0.2.0",
  "description": "fennecdb in the browser: the engine as WebAssembly, and dependency-free ES modules with its query builder, HTTP client and sync layer -- or the client alone, with no engine (@fennecdb/web/client)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "fennec.js",
  "types": "fennec.d.ts",
  "exports": {
    ".": {
      "types": "./fennec.d.ts",
      "default": "./fennec.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "default": "./schema.js"
    },
    "./fennec.wasm": "./fennec.wasm",
    "./collate/*": "./collate/*",
    "./package.json": "./package.json"
  },
  "files": [
    "fennec.js",
    "fennec.d.ts",
    "builder.js",
    "http.js",
    "client.js",
    "client.d.ts",
    "schema.js",
    "schema.d.ts",
    "fennec.wasm",
    "collate/"
  ],
  "sideEffects": false,
  "keywords": [
    "database",
    "vector",
    "embedded",
    "wasm",
    "hnsw",
    "bm25",
    "local-first",
    "sync"
  ],
  "homepage": "https://fennecdb.com/docs/javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fennec-db/fennecdb.git",
    "directory": "web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
