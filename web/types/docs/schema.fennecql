-- The collections the docs' TypeScript examples read and write.
-- fennec-schema.d.ts is what `fennec types` makes of them: docs.mjs says how
-- to make it again.
create collection articles (title text, body text @text, year int @sorted, category text, tags [text], published timestamp, embed vector<384> @hnsw(cosine), meta json)
create collection docs (title text @text, year int @sorted, embed vector<384> @hnsw(cosine))
create collection notes (text text)
create collection todos (key text @hash, title text, done bool @hash, at timestamp @sorted)
create collection tasks (key text @hash, title text, status text @hash, priority int @sorted, done bool @hash)
create collection people (name text collate und @sorted)
create collection products (name text @text, price int @sorted, brand text @hash, color text, tags [text])
create collection reviews (product_id int @hash, stars int, text text, created timestamp @sorted)
create collection shops (name text)
create collection orders (shop_id int @hash, code text)
create collection lines (order_id int @hash, item text, quantity int)
create collection places (name text, kind text @hash, loc geo @geo)
create collection accounts (owner text @hash, balance int)
create statement transfer($from int, $to int, $amount int) comment 'Moves money, or says why not.' public as begin set accounts {balance: balance - $amount} where id = $from and balance >= $amount require 1 else 'insufficient funds'; set accounts {balance: balance + $amount} where id = $to require 1 else 'no such account'; get accounts select id, balance where id = $from end
